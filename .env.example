# EduGuide local environment
# Copy this file to .env.local and replace every placeholder.

# =============================
# Groq / AI
# =============================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# =============================
# Optional semantic RAG
# Leave HF_TOKEN empty to use the built-in lexical RAG fallback.
# =============================
HF_TOKEN=
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# =============================
# Firebase Web App
# All six values MUST come from the same Firebase Web App/project.
# =============================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# =============================
# Firebase Admin service account
# Recommended for local Windows development.
# Put the downloaded JSON file at this exact path.
# =============================
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Alternative: instead of FIREBASE_SERVICE_ACCOUNT_PATH, you may provide:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# =============================
# Real Google Calendar + Google Meet demo scheduling
# =============================
DEMO_CALENDAR_ID=your_calendar_id@group.calendar.google.com
DEMO_TIMEZONE=Asia/Kolkata
DEMO_TIMEZONE_OFFSET=+05:30
DEMO_DURATION_MINUTES=30
